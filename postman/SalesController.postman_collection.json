    {
      "name": "5. Ventas - Pedidos",
      "item": [
        {
          "name": "Crear pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 con totales calculados', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const order = pm.response.json();",
                  "    pm.expect(order.orderNumber).to.match(/^SO-\\d{4}-\\d{6,}$/);",
                  "    pm.expect(order.status).to.eql('OPEN');",
                  "    pm.expect(order.totals.activeLines).to.eql(1);",
                  "    pm.collectionVariables.set('orderId', order.id);",
                  "    pm.collectionVariables.set('firstLineId', order.lines[0].id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"notes\": \"Pedido de prueba desde Postman\",\n  \"lines\": [\n    {\n      \"productId\": {{productId}},\n      \"kitName\": \"Selección Española blanca 2 estrellas\",\n      \"size\": \"M\",\n      \"customizations\": [\n        { \"customizationId\": {{customizationId}}, \"customText\": \"WILLIAMS JR 17\" }\n      ]\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/sales/orders"
          }
        },
        {
          "name": "Ver pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sales/orders/{{orderId}}"
          }
        },
        {
          "name": "Listar pedidos del cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 y aparece el pedido', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const ids = pm.response.json().map(o => o.id);",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get('orderId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/sales/orders?customerId={{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sales", "orders"],
              "query": [{ "key": "customerId", "value": "{{customerId}}" }]
            }
          }
        },
        {
          "name": "Editar cabecera del pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 con notas nuevas', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().notes).to.eql('Entregar en mano');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"orderDate\": \"2026-10-15\",\n  \"notes\": \"Entregar en mano\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/sales/orders/{{orderId}}"
          }
        },
        {
          "name": "Añadir línea (personalización gratis)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 con dos líneas y la personalización a 0', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const order = pm.response.json();",
                  "    pm.expect(order.totals.activeLines).to.eql(2);",
                  "    const added = order.lines[order.lines.length - 1];",
                  "    pm.expect(added.customizations[0].salePrice).to.eql(0);",
                  "    pm.collectionVariables.set('addedLineId', added.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"kitName\": \"Selección Española roja\",\n  \"size\": \"KIDS_24\",\n  \"customizations\": [\n    { \"customizationId\": {{customizationId}}, \"customText\": \"LUCAS 9\", \"salePrice\": 0 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/sales/orders/{{orderId}}/lines"
          }
        },
        {
          "name": "Sustituir línea (cambiar talla y precio)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 con la talla y el precio nuevos', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const line = pm.response.json().lines.find(l => l.id === Number(pm.collectionVariables.get('firstLineId')));",
                  "    pm.expect(line.size).to.eql('L');",
                  "    pm.expect(line.unitSalePrice).to.eql(14.00);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"kitName\": \"Selección Española blanca 2 estrellas\",\n  \"size\": \"L\",\n  \"unitSalePrice\": 14.00,\n  \"customizations\": [\n    { \"customizationId\": {{customizationId}}, \"customText\": \"WILLIAMS JR 17\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/sales/orders/{{orderId}}/lines/{{firstLineId}}"
          }
        },
        {
          "name": "Cancelar línea añadida",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200, la línea queda CANCELLED y no suma', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const order = pm.response.json();",
                  "    const line = order.lines.find(l => l.id === Number(pm.collectionVariables.get('addedLineId')));",
                  "    pm.expect(line.status).to.eql('CANCELLED');",
                  "    pm.expect(order.totals.activeLines).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/sales/orders/{{orderId}}/lines/{{addedLineId}}/cancel"
          }
        },
        {
          "name": "Error - cancelar la última línea (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409: hay que cancelar el pedido entero', () => {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json().detail).to.include('cancela el pedido entero');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/sales/orders/{{orderId}}/lines/{{firstLineId}}/cancel"
          }
        },
        {
          "name": "Error - pedido sin líneas (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 con error en lines', () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().errors[0].field).to.eql('lines');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"lines\": []\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/sales/orders"
          }
        },
        {
          "name": "Cancelar pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200, pedido CANCELLED y totales a 0', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const order = pm.response.json();",
                  "    pm.expect(order.status).to.eql('CANCELLED');",
                  "    pm.expect(order.totals.sale).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/sales/orders/{{orderId}}/cancel"
          }
        }
      ]
    }
  ]
}
