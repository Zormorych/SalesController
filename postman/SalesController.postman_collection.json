{
  "info": {
    "name": "SalesController",
    "description": "Pruebas manuales de la API de SalesController.\n\n**Cómo usarla**\n1. Importa esta colección y el entorno `SalesController-local.postman_environment.json` (File → Import).\n2. Selecciona el entorno **SalesController - Local** arriba a la derecha y ajusta `baseUrl` si el backend no está en el puerto 8080.\n3. Ejecuta las carpetas en orden (o la colección entera con *Run collection*): las peticiones de creación guardan los ids (`productId`, `customerId`, `orderId`...) que usan las siguientes.\n\nLos nombres y teléfonos de prueba llevan un sufijo aleatorio para poder ejecutar la colección varias veces sin chocar con los datos anteriores.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "productId", "value": "" },
    { "key": "productName", "value": "" },
    { "key": "customizationId", "value": "" },
    { "key": "customerId", "value": "" },
    { "key": "customerPhone", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "firstLineId", "value": "" },
    { "key": "addedLineId", "value": "" },
    { "key": "runSuffix", "value": "" }
  ],
  "item": [
    {
      "name": "0. Salud",
      "item": [
        {
          "name": "Comprobar que el backend responde",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 y status UP', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "1. Catálogo - Productos",
      "item": [
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Sufijo para no chocar con productos de ejecuciones anteriores (el nombre es único)",
                  "pm.collectionVariables.set('runSuffix', Date.now().toString().slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created con precios', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const product = pm.response.json();",
                  "    pm.expect(product.salePrice).to.eql(15.00);",
                  "    pm.expect(product.purchaseCost).to.eql(6.50);",
                  "    pm.expect(product.active).to.be.true;",
                  "    pm.collectionVariables.set('productId', product.id);",
                  "    pm.collectionVariables.set('productName', product.name);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Camiseta Fan {{runSuffix}}\",\n  \"salePrice\": 15.00,\n  \"purchaseCost\": 6.50\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/catalog/products"
          }
        },
        {
          "name": "Listar productos activos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 y aparece el producto creado', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const ids = pm.response.json().map(p => p.id);",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get('productId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/catalog/products"
          }
        },
        {
          "name": "Ver producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/catalog/products/{{productId}}"
          }
        },
        {
          "name": "Editar precios del producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 con el precio nuevo', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().salePrice).to.eql(16.00);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{productName}}\",\n  \"salePrice\": 16.00,\n  \"purchaseCost\": 6.50\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/catalog/products/{{productId}}"
          }
        },
        {
          "name": "Desactivar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 y active=false', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().active).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/catalog/products/{{productId}}/deactivate"
          }
        },
        {
          "name": "Listar productos incluidos los desactivados",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 y el producto desactivado aparece', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const product = pm.response.json().find(p => p.id === Number(pm.collectionVariables.get('productId')));",
                  "    pm.expect(product.active).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/catalog/products?includeInactive=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog", "products"],
              "query": [{ "key": "includeInactive", "value": "true" }]
            }
          }
        },
        {
          "name": "Activar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 y active=true', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().active).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/catalog/products/{{productId}}/activate"
          }
        },
        {
          "name": "Error - nombre duplicado (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 con mensaje en español', () => {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json().detail).to.include('Ya existe un producto llamado');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{productName}}\",\n  \"salePrice\": 15.00,\n  \"purchaseCost\": 6.50\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/catalog/products"
          }
        },
        {
          "name": "Error - precio con 3 decimales (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 con error en salePrice', () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().errors[0].field).to.eql('salePrice');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Precio raro {{runSuffix}}\",\n  \"salePrice\": 15.999,\n  \"purchaseCost\": 6.50\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/catalog/products"
          }
        }
      ]
    },
    {
