    {
      "name": "3. Catálogo - Tallas",
      "item": [
        {
          "name": "Listar tallas",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 con 12 tallas', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.have.lengthOf(12);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/catalog/sizes"
          }
        }
      ]
    },
    {
      "name": "4. Clientes",
      "item": [
        {
          "name": "Crear cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Teléfono aleatorio: el teléfono es único entre clientes",
                  "const digits = Math.floor(10000000 + Math.random() * 89999999);",
                  "pm.collectionVariables.set('customerPhone', '6' + digits);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 con el teléfono normalizado', () => {",
                  "    pm.response.to.have.status(201);",
                  "    const customer = pm.response.json();",
                  "    pm.expect(customer.phone).to.eql(pm.collectionVariables.get('customerPhone'));",
                  "    pm.collectionVariables.set('customerId', customer.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente Demo\",\n  \"phone\": \"{{customerPhone}}\",\n  \"notes\": \"Pide siempre talla M\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/customers"
          }
        },
        {
          "name": "Listar clientes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customers"
          }
        },
        {
          "name": "Buscar cliente por teléfono",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 y lo encuentra', () => {",
                  "    pm.response.to.have.status(200);",
                  "    const ids = pm.response.json().map(c => c.id);",
                  "    pm.expect(ids).to.include(Number(pm.collectionVariables.get('customerId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/customers?search={{customerPhone}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"],
              "query": [{ "key": "search", "value": "{{customerPhone}}" }]
            }
          }
        },
        {
          "name": "Ver cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customers/{{customerId}}"
          }
        },
        {
          "name": "Editar cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 con las notas nuevas', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().notes).to.eql('Cliente habitual');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente Demo\",\n  \"phone\": \"{{customerPhone}}\",\n  \"notes\": \"Cliente habitual\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/customers/{{customerId}}"
          }
        },
        {
          "name": "Error - teléfono duplicado (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 que nombra al dueño del teléfono', () => {",
                  "    pm.response.to.have.status(409);",
                  "    pm.expect(pm.response.json().detail).to.include('ya pertenece al cliente');",
                  "});"
                ]
              }
