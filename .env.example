# Copia este fichero como .env y cambia lo que necesites: docker compose lo lee automáticamente.
# El fichero .env no se sube a git.

# Puerto del equipo en el que se publica el backend (http://localhost:APP_PORT)
APP_PORT=8080

# Base de datos
POSTGRES_DB=sales_manager
POSTGRES_USER=sales_manager
POSTGRES_PASSWORD=sales_manager
# Puerto del equipo en el que se publica PostgreSQL (para conectarse con DBeaver, IntelliJ...)
POSTGRES_PORT=5432
